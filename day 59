def max_sub_array_sum(arr, k):
    n = len(arr)
    
    # Handle edge case where window size is larger than the array
    if n < k:
        print("Invalid size: k cannot be greater than the array length.")
        return

    # Compute sum of the first window of size k
    window_sum = sum(arr[:k])
    max_sum = window_sum

    # Slide the window from start to end of the array
    for i in range(n - k):
        # Subtract the element going out and add the element coming in
        window_sum = window_sum - arr[i] + arr[i + k]
        max_sum = max(max_sum, window_sum)

    print(f"The maximum sum of a subarray of size {k} is: {max_sum}")

# Driver code to test the function
if __name__ == "__main__":
    # Example Input
    arr = [2, 1, 5, 1, 3, 2]
    k = 3
    
    print(f"Array: {arr}")
    print(f"k: {k}")
    max_sub_array_sum(arr, k)
