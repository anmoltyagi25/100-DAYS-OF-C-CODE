#include <stdio.h>

int main() {
    int n, i, element;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    int arr[n + 1];

    for (i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            return 1;
        }
    }

    if (scanf("%d", &element) != 1) {
        return 1;
    }

    i = n - 1;
    while (i >= 0 && arr[i] > element) {
        arr[i + 1] = arr[i];
        i--;
    }
    arr[i + 1] = element;

    for (i = 0; i <= n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
