#include <stdio.h>

int main() {
    char str1[500];
    char str2[500];
    char temp[1000];
    int len1 = 0, len2 = 0, i, j, match;

    if (fgets(str1, sizeof(str1), stdin) == NULL) {
        return 1;
    }
    if (fgets(str2, sizeof(str2), stdin) == NULL) {
        return 1;
    }

    while (str1[len1] != '\0') {
        len1++;
    }
    if (len1 > 0 && str1[len1 - 1] == '\n') {
        str1[len1 - 1] = '\0';
        len1--;
    }

    while (str2[len2] != '\0') {
        len2++;
    }
    if (len2 > 0 && str2[len2 - 1] == '\n') {
        str2[len2 - 1] = '\0';
        len2--;
    }

    if (len1 != len2) {
        printf("Not Rotation\n");
        return 0;
    }

    for (i = 0; i < len1; i++) {
        temp[i] = str1[i];
        temp[i + len1] = str1[i];
    }
    temp[2 * len1] = '\0';

    match = 0;
    for (i = 0; i <= len1; i++) {
        for (j = 0; j < len1; j++) {
            if (temp[i + j] != str2[j]) {
                break;
            }
        }
        if (j == len1) {
            match = 1;
            break;
        }
    }

    if (match) {
        printf("Rotation\n");
    } else {
        printf("Not Rotation\n");
    }

    return 0;
}
