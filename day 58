#include <stdio.h>

int main() {
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0) {
        return 0;
    }

    int nums[n];
    int answer[n];

    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &nums[i]);
    }

    answer[0] = 1;
    for (int i = 1; i < n; i++) {
        answer[i] = answer[i - 1] * nums[i - 1];
    }

    int suffixProduct = 1;
    for (int i = n - 1; i >= 0; i--) {
        answer[i] = answer[i] * suffixProduct;
        suffixProduct = suffixProduct * nums[i];
    }

    printf("Answer array: ");
    for (int i = 0; i < n; i++) {
        if (i == n - 1) {
            printf("%d", answer[i]);
        } else {
            printf("%d, ", answer[i]);
        }
    }
    printf("\n");

    return 0;
}
