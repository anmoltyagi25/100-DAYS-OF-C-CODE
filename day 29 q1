#include <stdio.h>

int main() {
    int n, i, sum = 0;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    int arr[n];

    for (i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            return 1;
        }
        sum += arr[i];
    }

    printf("%d\n", sum);

    return 0;
}
