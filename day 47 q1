#include <stdio.h>

int main() {
    char str1[1000];
    char str2[1000];
    int count[256] = {0};
    int i = 0, isAnagram = 1;

    if (fgets(str1, sizeof(str1), stdin) == NULL) {
        return 1;
    }
    if (fgets(str2, sizeof(str2), stdin) == NULL) {
        return 1;
    }

    while (str1[i] != '\0') {
        if (str1[i] != '\n') {
            count[(unsigned char)str1[i]]++;
        }
        i++;
    }

    i = 0;
    while (str2[i] != '\0') {
        if (str2[i] != '\n') {
            count[(unsigned char)str2[i]]--;
        }
        i++;
    }

    for (i = 0; i < 256; i++) {
        if (count[i] != 0) {
            isAnagram = 0;
            break;
        }
    }

    if (isAnagram) {
        printf("Anagram\n");
    } else {
        printf("Not Anagram\n");
    }

    return 0;
}
