#include <stdio.h>

int main() {
    int n;

    printf("Enter the size of the array (n): ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("0\n");
        return 0;
    }

    int arr[n];
    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int missing = n; 
    for (int i = 0; i < n; i++) {
        missing = missing ^ i ^ arr[i];
    }

    printf("%d\n", missing);

    return 0;
}
