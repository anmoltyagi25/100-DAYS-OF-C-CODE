#include <stdio.h>

int main() {
    char str[1000];
    int length = 0;
    int i;
    char temp;

    if (fgets(str, sizeof(str), stdin) == NULL) {
        return 1;
    }

    while (str[length] != '\0') {
        length++;
    }

    if (length > 0 && str[length - 1] == '\n') {
        str[length - 1] = '\0';
        length--;
    }

    for (i = 0; i < length / 2; i++) {
        temp = str[i];
        str[i] = str[length - 1 - i];
        str[length - 1 - i] = temp;
    }

    printf("%s\n", str);

    return 0;
}
