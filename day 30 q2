#include <stdio.h>

int main() {
    int n, i, positiveCount = 0, negativeCount = 0, zeroCount = 0;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    int arr[n];

    for (i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            return 1;
        }
        if (arr[i] > 0) {
            positiveCount++;
        } else if (arr[i] < 0) {
            negativeCount++;
        } else {
            zeroCount++;
        }
    }

    printf("Positive: %d\n", positiveCount);
    printf("Negative: %d\n", negativeCount);
    printf("Zero: %d\n", zeroCount);

    return 0;
}
