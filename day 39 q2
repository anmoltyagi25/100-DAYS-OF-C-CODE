#include <stdio.h>

int main() {
    int n, i, j, sum = 0;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    int matrix[n][n];

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            if (scanf("%d", &matrix[i][j]) != 1) {
                return 1;
            }
        }
    }

    for (i = 0; i < n; i++) {
        sum += matrix[i][i];
    }

    printf("%d\n", sum);

    return 0;
}
