#include <stdio.h>

int main() {
    int n, sum = 0, current_odd = 1;

    printf("Enter the value of n: ");
    if (scanf("%d", &n) != 1 || n < 1) {
        printf("Invalid input. Please enter a positive integer.\n");
        return 1;
    }

    for (int i = 1; i <= n; i++) {
        sum += current_odd;
        current_odd += 2;
    }

    printf("Sum of the first %d odd numbers = %d\n", n, sum);

    return 0;
}
