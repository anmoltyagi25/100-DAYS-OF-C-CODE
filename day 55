#include <stdio.h>

int findMajorityElement(int nums[], int size) {
    int candidate = -1;
    int count = 0;

    for (int i = 0; i < size; i++) {
        if (count == 0) {
            candidate = nums[i];
            count = 1;
        } else if (nums[i] == candidate) {
            count++;
        } else {
            count--;
        }
    }

    int actualCount = 0;
    for (int i = 0; i < size; i++) {
        if (nums[i] == candidate) {
            actualCount++;
        }
    }

    if (actualCount > size / 2) {
        return candidate;
    }

    return -1;
}

int main() {
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    int nums[n];
    printf("Enter %d elements: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &nums[i]);
    }

    int majority = findMajorityElement(nums, n);
    printf("%d\n", majority);

    return 0;
}
