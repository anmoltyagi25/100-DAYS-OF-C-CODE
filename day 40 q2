#include <stdio.h>

int main() {
    int r1, c1, r2, c2, i, j, k;

    if (scanf("%d %d", &r1, &c1) != 2 || r1 <= 0 || c1 <= 0) {
        return 1;
    }
    int m1[r1][c1];
    for (i = 0; i < r1; i++) {
        for (j = 0; j < c1; j++) {
            if (scanf("%d", &m1[i][j]) != 1) {
                return 1;
            }
        }
    }

    if (scanf("%d %d", &r2, &c2) != 2 || r2 <= 0 || c2 <= 0) {
        return 1;
    }
    
    if (c1 != r2) {
        printf("Matrix multiplication not possible\n");
        return 1;
    }

    int m2[r2][c2];
    for (i = 0; i < r2; i++) {
        for (j = 0; j < c2; j++) {
            if (scanf("%d", &m2[i][j]) != 1) {
                return 1;
            }
        }
    }

    int prod[r1][c2];

    for (i = 0; i < r1; i++) {
        for (j = 0; j < c2; j++) {
            prod[i][j] = 0;
            for (k = 0; k < c1; k++) {
                prod[i][j] += m1[i][k] * m2[k][j];
            }
        }
    }

    for (i = 0; i < r1; i++) {
        for (j = 0; j < c2; j++) {
            printf("%d ", prod[i][j]);
        }
        printf("\n");
    }

    return 0;
}
