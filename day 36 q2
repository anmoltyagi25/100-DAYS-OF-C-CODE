#include <stdio.h>

int main() {
    int rows, cols, i, j, sum = 0;

    if (scanf("%d %d", &rows, &cols) != 2 || rows <= 0 || cols <= 0) {
        return 1;
    }

    int matrix[rows][cols];

    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            if (scanf("%d", &matrix[i][j]) != 1) {
                return 1;
            }
            sum += matrix[i][j];
        }
    }

    printf("%d\n", sum);

    return 0;
}
