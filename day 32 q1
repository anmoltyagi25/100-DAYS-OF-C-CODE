#include <stdio.h>

int main() {
    int n1, n2, i;

    if (scanf("%d", &n1) != 1 || n1 <= 0) {
        return 1;
    }
    int arr1[n1];
    for (i = 0; i < n1; i++) {
        if (scanf("%d", &arr1[i]) != 1) {
            return 1;
        }
    }

    if (scanf("%d", &n2) != 1 || n2 <= 0) {
        return 1;
    }
    int arr2[n2];
    for (i = 0; i < n2; i++) {
        if (scanf("%d", &arr2[i]) != 1) {
            return 1;
        }
    }

    int merged[n1 + n2];

    for (i = 0; i < n1; i++) {
        merged[i] = arr1[i];
    }

    for (i = 0; i < n2; i++) {
        merged[n1 + i] = arr2[i];
    }

    for (i = 0; i < n1 + n2; i++) {
        printf("%d ", merged[i]);
    }
    printf("\n");

    return 0;
}
