#include <stdio.h>

int main() {
    char str[200];
    int i = 0;

    if (fgets(str, sizeof(str), stdin) == NULL) {
        return 1;
    }

    while (str[i] == ' ' || str[i] == '\t') {
        i++;
    }

    if (str[i] != '\0' && str[i] != '\n') {
        printf("%c", str[i]);
    }

    while (str[i] != '\0') {
        if ((str[i] == ' ' || str[i] == '\t') && (str[i + 1] != ' ' && str[i + 1] != '\t' && str[i + 1] != '\n' && str[i + 1] != '\0')) {
            printf("%c", str[i + 1]);
        }
        i++;
    }
    printf("\n");

    return 0;
}
