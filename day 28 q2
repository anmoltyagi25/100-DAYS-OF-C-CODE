#include <stdio.h>

int main() {
    int n, i;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    int arr[n];

    for (i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            return 1;
        }
    }

    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
