#include <stdio.h>

int main() {
    char str[1000];
    int counts[26] = {0};
    int i = 0;
    char found = '\0';

    if (fgets(str, sizeof(str), stdin) == NULL) {
        return 1;
    }

    while (str[i] != '\0') {
        if (str[i] >= 'a' && str[i] <= 'z') {
            int index = str[i] - 'a';
            counts[index]++;
            if (counts[index] == 2) {
                found = str[i];
                break;
            }
        }
        i++;
    }

    if (found != '\0') {
        printf("%c\n", found);
    } else {
        printf("No repeating lowercase character found\n");
    }

    return 0;
}
