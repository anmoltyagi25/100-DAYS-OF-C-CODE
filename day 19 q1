#include <stdio.h>

int main() {
    int num1, num2, max;

    printf("Enter two integers: ");
    if (scanf("%d %d", &num1, &num2) != 2) {
        printf("Invalid input.\n");
        return 1;
    }

    int a = (num1 < 0) ? -num1 : num1;
    int b = (num2 < 0) ? -num2 : num2;

    if (a == 0 || b == 0) {
        printf("LCM of %d and %d = 0\n", num1, num2);
        return 0;
    }

    max = (a > b) ? a : b;

    while (1) {
        if (max % a == 0 && max % b == 0) {
            printf("LCM of %d and %d = %d\n", num1, num2, max);
            break;
        }
        max++;
    }

    return 0;
}
