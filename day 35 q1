#include <stdio.h>
#include <limits.h>

int main() {
    int n, i, max, secondMax;

    if (scanf("%d", &n) != 1 || n < 2) {
        return 1;
    }

    int arr[n];

    for (i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            return 1;
        }
    }

    max = INT_MIN;
    secondMax = INT_MIN;

    for (i = 0; i < n; i++) {
        if (arr[i] > max) {
            secondMax = max;
            max = arr[i];
        } else if (arr[i] > secondMax && arr[i] != max) {
            secondMax = arr[i];
        }
    }

    if (secondMax == INT_MIN) {
        printf("No second largest element found\n");
    } else {
        printf("%d\n", secondMax);
    }

    return 0;
}
