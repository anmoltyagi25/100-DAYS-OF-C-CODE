#include <stdio.h>

int main() {
    int n, i, element, position;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    int arr[n + 1];

    for (i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            return 1;
        }
    }

    if (scanf("%d %d", &element, &position) != 2) {
        return 1;
    }

    if (position < 0 || position > n) {
        return 1;
    }

    for (i = n; i > position; i--) {
        arr[i] = arr[i - 1];
    }
    
    arr[position] = element;

    for (i = 0; i <= n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
