#include <stdio.h>

int main() {
    int n, i, position;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    int arr[n];

    for (i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            return 1;
        }
    }

    if (scanf("%d", &position) != 1) {
        return 1;
    }

    if (position < 0 || position >= n) {
        return 1;
    }

    for (i = position; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }

    for (i = 0; i < n - 1; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
