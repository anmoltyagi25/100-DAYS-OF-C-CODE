#include <stdio.h>

int main() {
    int num;
    int binary[32];
    int i = 0;

    printf("Enter an integer: ");
    if (scanf("%d", &num) != 1) {
        printf("Invalid input.\n");
        return 1;
    }

    if (num == 0) {
        printf("Binary representation: 0\n");
        return 0;
    }

    int temp = (num < 0) ? -num : num;

    while (temp > 0) {
        binary[i] = temp % 2;
        temp /= 2;
        i++;
    }

    printf("Binary representation: ");
    if (num < 0) {
        printf("-");
    }

    for (int j = i - 1; j >= 0; j--) {
        printf("%d", binary[j]);
    }
    printf("\n");

    return 0;
}
