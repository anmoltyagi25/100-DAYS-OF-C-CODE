#include <stdio.h>

int main() {
    int rows, cols, i, j, k;

    if (scanf("%d %d", &rows, &cols) != 2 || rows <= 0 || cols <= 0) {
        return 1;
    }

    int matrix[rows][cols];

    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            if (scanf("%d", &matrix[i][j]) != 1) {
                return 1;
            }
        }
    }

    for (k = 0; k < cols; k++) {
        i = 0;
        j = k;
        while (j >= 0 && i < rows) {
            printf("%d ", matrix[i][j]);
            i++;
            j--;
        }
    }

    for (k = 1; k < rows; k++) {
        i = k;
        j = cols - 1;
        while (i < rows && j >= 0) {
            printf("%d ", matrix[i][j]);
            i++;
            j--;
        }
    }
    printf("\n");

    return 0;
}
