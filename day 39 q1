#include <stdio.h>

int main() {
    int n, i, j, isDistinct = 1;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    int matrix[n][n];

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            if (scanf("%d", &matrix[i][j]) != 1) {
                return 1;
            }
        }
    }

    for (i = 0; i < n; i++) {
        for (j = i + 1; j < n; j++) {
            if (matrix[i][i] == matrix[j][j]) {
                isDistinct = 0;
                break;
            }
        }
        if (!isDistinct) {
            break;
        }
    }

    if (isDistinct) {
        printf("Distinct\n");
    } else {
        printf("Not Distinct\n");
    }

    return 0;
}
