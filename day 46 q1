#include <stdio.h>

int main() {
    char str[1000];
    int i = 0, j = 0;

    if (fgets(str, sizeof(str), stdin) == NULL) {
        return 1;
    }

    while (str[i] != '\0') {
        char ch = str[i];
        if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ||
            ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U') {
            i++;
        } else {
            str[j] = str[i];
            i++;
            j++;
        }
    }
    str[j] = '\0';

    printf("%s", str);

    return 0;
}
